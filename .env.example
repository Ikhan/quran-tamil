# Quran Tamil — copy to .env and fill in

# 3004 is quran-reels, 3003 is the hadith app
PORT=3005
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me
NODE_ENV=development

# Single app user
APP_USERNAME=admin
APP_PASSWORD=change_me

# Pexels, for fetching cover photographs (scripts/fetch_cover_photos.py)
PEXELS_API_KEY=

# Posting to Instagram from the Schedule tab. Leave empty and posts still queue;
# they wait until a token is set and the server restarted.
# Either kind of token works; the server asks Instagram which one it is (a
# Unified Login token starts with EAA but is an Instagram Login token):
#   Instagram Login — Instagram fetches the reel from a temporary Cloudflare
#     link (brew install cloudflared). Refreshed weekly, kept in
#     data/instagram-token.json.
#   Facebook Login / Business system user — the reel is uploaded directly.
# Covers always go by a temporary link, so cloudflared is needed for them too.
INSTAGRAM_ACCESS_TOKEN=
# Only needed when a Business token can't find the account on its own.
# INSTAGRAM_USER_ID=
# INSTAGRAM_GRAPH_VERSION=v24.0
# Only if detection picks wrong: instagram | facebook
# INSTAGRAM_LOGIN=

# Where posts are published from. Once `npm run aws:setup` has run (it writes
# data/aws-posting.json), AWS — posts go out with this Mac off. Set to `local`
# to post from this Mac instead.
# POSTING_BACKEND=
# AWS_POSTING_REGION=ap-south-1
